# Copy to .env.local. VITE_* values are baked in at build time.

# --- Multiplayer (Versus) ---
# Address of the match server (server/). Unset in dev = ws://localhost:8787. Unset in production = Versus hidden.
VITE_VERSUS_URL=

# --- Ads (Google AdSense) ---
# Publisher id. Without it no ad script is ever loaded.
VITE_ADSENSE_CLIENT=
# Display ad unit ids per placement (Home, Games, Versus). Leave empty to skip a placement.
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_GAMES=
VITE_ADSENSE_SLOT_VERSUS=
# Rewarded ads (watch for orbs / second chance): h5 = Google H5 Games Ads, mock = placeholder, off = none.
VITE_ADS_PROVIDER=off

# --- Analytics (PostHog) ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# --- Voice games (server-side only, no VITE_ prefix) ---
SARVAM_API_KEY=

# --- Feedback form link (optional) ---
VITE_FEEDBACK_URL=
